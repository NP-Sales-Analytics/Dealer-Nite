# Salin menjadi .env.loadtest. Jangan commit nilai rahasia.
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
BASE_URL=

# Run unik. Buat dengan: npm run loadtest:new-run
LOADTEST_RUN_ID=

# Untuk staging/local boleh kosong. Untuk produksi, keempatnya wajib lengkap.
IZINKAN_PRODUKSI=
KONFIRMASI_RUN_PRODUKSI=
OBSERVABILITY_SIAP=
TIM_SUDAH_DIBERI_TAHU=

# Opsional
STAFF=20
LAJU_KONEKSI=10
